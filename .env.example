FLASK_APP=run.py
FLASK_ENV=development
# Sal do hash anônimo dos relatos de energia. Obrigatória para expor o servidor na rede
# (o run.py recusa subir com chave vazia ou pública). Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Configuração unificada do banco SQLite
DATABASE_URL=sqlite:///instance/climae_zonasul.db

# Altere para suas credenciais do PostgreSQL caso queira usá-lo:
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/climae_zonasul

# Servidor (run.py). Padrão: só a própria máquina, com debug.
# CLIMAE_HOST=0.0.0.0 expõe na rede local e DESLIGA o debug automaticamente.
CLIMAE_HOST=127.0.0.1
CLIMAE_PORT=5000
FLASK_DEBUG=1

# Token para publicar boletins oficiais (POST /api/power/bulletins, header X-Admin-Token).
# Vazio = endpoint desativado. Use um valor longo e aleatório.
ADMIN_API_TOKEN=

# Nº de proxies reversos confiáveis à frente do app (ex.: Nginx = 1).
# 0 = ignora X-Forwarded-For (o cliente pode forjá-lo).
TRUSTED_PROXY_COUNT=0
